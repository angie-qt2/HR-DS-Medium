class Result
{

    /*
     * Complete the 'contacts' function below.
     *
     * The function is expected to return an INTEGER_ARRAY.
     * The function accepts 2D_STRING_ARRAY queries as parameter.
     */
class TrieNode
    {
        public Dictionary<char, TrieNode> Children = new Dictionary<char, TrieNode>();
        public int Count = 0;
    }

    private static TrieNode root = new TrieNode();
    
    public static List<int> contacts(List<List<string>> queries)
    {
         List<int> result = new List<int>();
        root = new TrieNode();

        foreach (var q in queries)
        {
            string op = q[0];
            string value = q[1];

            if (op == "add")
            {
                Add(value);
            }
            else if (op == "find")
            {
                result.Add(Find(value));
            }
        }

        return result;
    }

    private static void Add(string name)
    {
        TrieNode node = root;
        foreach (char c in name)
        {
            if (!node.Children.ContainsKey(c))
                node.Children[c] = new TrieNode();

            node = node.Children[c];
            node.Count++; 
        }
    }

    private static int Find(string prefix)
    {
        TrieNode node = root;
        foreach (char c in prefix)
        {
            if (!node.Children.ContainsKey(c))
                return 0;

            node = node.Children[c];
        }
        return node.Count;
    
    }

}

class Solution
{
    public static void Main(string[] args)
    {
        TextWriter textWriter = new StreamWriter(@System.Environment.GetEnvironmentVariable("OUTPUT_PATH"), true);

        int queriesRows = Convert.ToInt32(Console.ReadLine().Trim());

        List<List<string>> queries = new List<List<string>>();

        for (int i = 0; i < queriesRows; i++)
        {
            queries.Add(Console.ReadLine().TrimEnd().Split(' ').ToList());
        }

        List<int> result = Result.contacts(queries);

        textWriter.WriteLine(String.Join("\n", result));

        textWriter.Flush();
        textWriter.Close();
    }
}
